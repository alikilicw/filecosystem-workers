# Copy to .env for running a worker from source against the infrastructure
# started by filecosystem-be/docker-compose.yml.
APP_ENV=development
WORKER_CONCURRENCY=4
MAX_SOURCE_BYTES=52428800
JOB_TIMEOUT=2m
METRICS_ADDR=:8090

RABBITMQ_URL=amqp://filecosystem:filecosystem@localhost:5672/

# Amazon S3 — leave S3_ENDPOINT empty for real AWS.
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
S3_USE_PATH_STYLE=false
S3_PRESIGN_TTL=1h
